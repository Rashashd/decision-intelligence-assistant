# OpenAI (primary)
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini (fallback LLM — leave empty to disable fallback)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Embedding provider
# "openai" or "gemini" — must be the same value when you run ingest.py and at runtime
# Changing this after ingestion requires re-running ingest.py to rebuild the vector store
EMBEDDING_PROVIDER=openai

# CORS
# Comma-separated list of frontend origins allowed to call the API
# In Docker this should match the host+port the frontend is served on
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=support_tickets

# RAG settings
TOP_K_RESULTS=5

# Paths
LOG_DIR=./logs
MODEL_PATH=./models/priority_classifier.joblib
